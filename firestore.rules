rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Helper Functions (Zero DB Reads)
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    function isManager() {
      return isAuthenticated() && (request.auth.token.role == 'manager' || isSuperAdmin());
    }

    function hasPermission(permissionName) {
      return isSuperAdmin() || (
        isManager() && 
        request.auth.token.permissions != null && 
        (permissionName in request.auth.token.permissions || 'all' in request.auth.token.permissions)
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // Collections Rules
    // ==========================================

    // 1. Products
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if hasPermission('products');
    }

    match /product_changes/{changeId} {
      allow read: if true;
      allow create: if hasPermission('products');
    }

    // 1.5 Taxonomy
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if hasPermission('settings');
    }
    match /brands/{brandId} {
      allow read: if true;
      allow create, update, delete: if hasPermission('settings');
    }
    match /collections/{collectionId} {
      allow read: if true;
      allow create, update, delete: if hasPermission('settings');
    }

    // 2. Orders
    match /orders/{orderId} {
      allow read: if isOwner(resource.data.user_id) || hasPermission('orders');
      allow create: if isAuthenticated() && (request.resource.data.user_id == request.auth.uid || hasPermission('orders'))
                     && request.resource.data.status == 'pending' 
                     && request.resource.data.payment_status == 'pending';
      allow update: if hasPermission('orders');
      allow delete: if isSuperAdmin();
    }

    // 3. Users (Customers)
    match /users/{userId} {
      allow read: if isOwner(userId) || hasPermission('users');
      allow create, update: if isOwner(userId) || hasPermission('users');
      allow delete: if isSuperAdmin();
    }

    // 4. Managers Directory
    match /managers/{managerId} {
      allow read: if isOwner(managerId) || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // 5. Store Settings & Hero
    match /hero/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 6. Favorites
    match /favorites/{favoriteId} {
      allow read, delete: if isOwner(resource.data.user_id);
      allow create, update: if isOwner(request.resource.data.user_id);
    }

    // 7. Push Tokens
    match /manager_push_tokens/{tokenId} {
      allow read, write: if isManager();
    }
    match /user_push_tokens/{tokenId} {
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow read, update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // 8. Inventory
    match /inventory/{productId} {
      allow read: if true;
      allow write: if hasPermission('products');
    }

    // 9. Stats / Revenue
    match /stats/{document=**} {
      allow read: if hasPermission('orders');
      allow write: if isSuperAdmin();
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
